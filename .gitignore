# Dependencies
node_modules/
services/*/node_modules/

# Build output
dist/
services/*/dist/
services/client/dist/

# Environment & secrets - NEVER commit these
.env
*.local
master.key
*.key
*.pem
!ansible/**/*.key.j2
secrets/
certs/

# Test / coverage
coverage/
*.log

# Editor
.DS_Store
.idea/
.vscode/*
!.vscode/extensions.json

# Runtime
data/
mongo-data/

# Local working notes (plans, scratch analysis) - never committed
*.local.md

# Python bytecode (projects/)
__pycache__/
*.py[cod]
