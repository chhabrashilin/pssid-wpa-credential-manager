# ---------------------------------------------------------------------------
# pSSID Credential Manager - environment configuration
# Copy to .env and fill in. NEVER commit .env.
# ---------------------------------------------------------------------------

# --- Server ---
PORT=8080
NODE_ENV=production
# Public base URL (used for OIDC callbacks and pull-URL snippets)
BASE_URL=https://credmgr.example.edu

# --- Database ---
MONGO_URL=mongodb://mongo:27017
MONGO_DB=credmgr

# --- Master key (KEK) - envelope encryption ---
# Preferred: a file readable only by the app (mode 0400).
KEK_FILE=/etc/pssid-credmgr/master.key
# Fallback for container platforms: base64-encoded 32-byte key.
# Exactly one of KEK_FILE or KEK_BASE64 must resolve to a valid 32-byte key.
# KEK_BASE64=

# --- Authentication ---
# When SSO is off, the app is READ-ONLY unless OPEN_WRITE=true (lab mode).
SSO_ENABLED=false
OPEN_WRITE=false

# OIDC (used only when SSO_ENABLED=true) - express-openid-connect style
OIDC_ISSUER_BASE_URL=https://login.example.edu
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
# Random 32+ char string used to encrypt the session cookie
SESSION_SECRET=

# Path to the JSON file mapping OIDC group claims to roles.
ROLE_MAP_FILE=/etc/pssid-credmgr/roles.json

# --- Policy ---
ROTATION_WARN_DAYS=180
