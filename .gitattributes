# Shell scripts and Makefiles must keep LF endings everywhere: bash rejects
# CRLF scripts ("set: pipefail: invalid option name", broken shebangs) and
# make rejects CRLF recipes, so a Windows checkout with autocrlf enabled would
# otherwise break the installer, the smoke suite, and the probe pull helper.
*.sh text eol=lf
Makefile text eol=lf

# Dockerfiles build on Linux hosts regardless of the checkout platform.
Dockerfile text eol=lf
.dockerignore text eol=lf

# Python and the extensionless launcher ship to Linux probes; a CRLF shebang
# fails there with a confusing "no such file or directory" naming the
# interpreter. Pin them the same way *.sh is pinned.
*.py text eol=lf
